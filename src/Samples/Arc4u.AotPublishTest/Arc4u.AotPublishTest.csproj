    <TrimmerRootAssembly Include="Arc4u.Caching.Dapr" />
    <TrimmerRootAssembly Include="Arc4u.Caching.Memory" />
    <TrimmerRootAssembly Include="Arc4u.Caching.Redis" />
    <TrimmerRootAssembly Include="Arc4u.Caching.Sql" />
    <TrimmerRootAssembly Include="Arc4u.Configuration" />
    <TrimmerRootAssembly Include="Arc4u.Configuration.Decryptor" />
    <TrimmerRootAssembly Include="Arc4u.Configuration.Store" />
    <TrimmerRootAssembly Include="Arc4u.Configuration.Store.EFCore" />
    <TrimmerRootAssembly Include="Arc4u.Core" />
    <TrimmerRootAssembly Include="Arc4u.Dependency" />
    <TrimmerRootAssembly Include="Arc4u.Diagnostics" />
    <TrimmerRootAssembly Include="Arc4u.Diagnostics.Serilog" />
    <TrimmerRootAssembly Include="Arc4u.Diagnostics.Serilog.Sinks.RealmDb" />
    <TrimmerRootAssembly Include="Arc4u.Dispatcher" />
    <TrimmerRootAssembly Include="Arc4u.EfCore" />
