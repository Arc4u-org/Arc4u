    <TrimmerRootAssembly Include="Arc4u.OAuth2.AspNetCore.Blazor" />
    <TrimmerRootAssembly Include="Arc4u.OAuth2.Blazor" />
    <TrimmerRootAssembly Include="Arc4u.OAuth2.Client" />
    <TrimmerRootAssembly Include="Arc4u.OAuth2.Client.Authentication" />
    <TrimmerRootAssembly Include="Arc4u.OData" />
    <TrimmerRootAssembly Include="Arc4u.Results" />
    <TrimmerRootAssembly Include="Arc4u.Serializer" />
    <TrimmerRootAssembly Include="Arc4u.Serializer.JSon" />
    <TrimmerRootAssembly Include="Arc4u.Threading" />
    <TrimmerRootAssembly Include="Arc4u.gRPC" />
  </ItemGroup>

  <Target Name="ReportEveryArc4uWarning" BeforeTargets="WriteIlcRspFileForCompilation">
    <ItemGroup>
      <ManagedAssemblyToLink Condition="$([System.String]::Copy('%(Filename)').StartsWith('Arc4u.'))">
        <TrimmerSingleWarn>false</TrimmerSingleWarn>
      </ManagedAssemblyToLink>
    </ItemGroup>
  </Target>

</Project>
