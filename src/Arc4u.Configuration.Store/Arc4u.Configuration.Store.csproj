<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <PackageId>Arc4u.Configuration.Store</PackageId>
    <!-- The only binder call (Add<TValue>(key)) binds a type chosen by the application, which the generator cannot handle (SYSLIB1104).
         It is marked RequiresUnreferencedCode/RequiresDynamicCode instead; AddFromConfiguration lets the application generate the binding. -->
    <EnableConfigurationBindingGenerator>false</EnableConfigurationBindingGenerator>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Arc4u.Configuration\Arc4u.Configuration.csproj" />
    <ProjectReference Include="..\Arc4u.Core\Arc4u.Core.csproj" />
  </ItemGroup>

</Project>
